    "measure_power": {
      "title": {
        "en": "Apparent power (VA)",
        "fr": "Puissance apparente (VA)"
      },
      "decimals": 2,
      "insights": true
    },
    "button.reset_daily_cost": {
      "maintenanceAction": true,
      "title": {
        "en": "Reset the cost of the day",
        "fr": "Remettre à zéro le coût du jour"
      },
      "desc": {
        "en": "Restart the consumption of the day from zero: the reference indexes are set to the current ones. The subscription share of the day remains counted.",
        "fr": "Repart de zéro pour la consommation du jour: les index de référence sont recalés sur les index actuels. La part d'abonnement du jour reste comptée."
      }
    }
  },
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Power",
        "fr": "Puissance"
      },
      "children": [
        {
          "id": "power_source",
          "type": "dropdown",
          "label": {
            "en": "Power sent to Homey Energy",
            "fr": "Puissance transmise à Homey Energy"
          },
          "hint": {
            "en": "Apparent: instantaneous, but includes reactive power, so higher than what you pay for. Estimated active: computed from the energy index (standard mode only), matches what you pay for, smoothed over 30 s to 5 min depending on the load.",
            "fr": "Apparente : instantanée, mais inclut la puissance réactive, donc plus élevée que ce qui est facturé. Active estimée : calculée à partir de l'index d'énergie (mode standard uniquement), correspond à ce qui est facturé, lissée sur 30 s à 5 min selon la charge."
          },
          "value": "apparent",
          "values": [
            {
              "id": "apparent",
              "label": {
                "en": "Apparent power (instantaneous)",
                "fr": "Puissance apparente (instantanée)"
              }
            },
            {
              "id": "active_estimated",
              "label": {
                "en": "Estimated active power",
                "fr": "Puissance active estimée"
              }
            }
          ]
        }
      ]
